#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf 'usage: cxci (-a|-s|-k) [-y] [-p] [-.] [-c] [-l|-m|-h|-x] [-f] [instructions...] [-- codexd_args...]\n' >&2
}

help() {
    usage 2>&1
    cat <<'EOF'

Flags:
  -a      Commit all changes ($commit --all).
  -s      Commit only staged changes ($commit --staged).
  -k      Ask interactively what to commit ($commit --ask).
  -y      Preconfirm the commit gate; valid only with -a or -s.
  -p      Push the branch after the commit lands (mode suffix -push).
  -.      Use $gdf-commit instead of $commit.
  -c      Use gpt-5.3-codex-spark (default effort: xhigh).
  -l      Use low model reasoning effort.
  -m      Use medium model reasoning effort (default).
  -h      Use high model reasoning effort.
  -x      Use xhigh model reasoning effort.
  -f      Use the fast service tier.
  --      Pass all remaining arguments directly to codexd.
  --help  Show this help.

Bare (non-flag) arguments are appended to the commit command as additional
instructions, e.g. `cxci -a use imperative mood`.
EOF
}

mode=
commit_command=commit
model=gpt-5.6-sol
effort=medium
effort_set=0
fast=0
preconfirmed=0
push=0
instructions=()
codex_args=()

while (($#)); do
    case "$1" in
        -a)
            if [[ -n "$mode" ]]; then usage; exit 2; fi
            mode=all
            ;;
        -s)
            if [[ -n "$mode" ]]; then usage; exit 2; fi
            mode=staged
            ;;
        -k)
            if [[ -n "$mode" ]]; then usage; exit 2; fi
            mode=ask
            ;;
        -.)
            commit_command=gdf-commit
            ;;
        -c)
            model=gpt-5.3-codex-spark
            if [[ "$effort_set" -eq 0 ]]; then
                effort=xhigh
            fi
            ;;
        -l)
            if [[ "$effort_set" -eq 1 ]]; then usage; exit 2; fi
            effort=low
            effort_set=1
            ;;
        -m)
            if [[ "$effort_set" -eq 1 ]]; then usage; exit 2; fi
            effort=medium
            effort_set=1
            ;;
        -h)
            if [[ "$effort_set" -eq 1 ]]; then usage; exit 2; fi
            effort=high
            effort_set=1
            ;;
        -x)
            if [[ "$effort_set" -eq 1 ]]; then usage; exit 2; fi
            effort=xhigh
            effort_set=1
            ;;
        -f)
            fast=1
            ;;
        -y)
            preconfirmed=1
            ;;
        -p)
            push=1
            ;;
        --help)
            help
            exit 0
            ;;
        --)
            shift
            codex_args=("$@")
            break
            ;;
        -*)
            usage
            exit 2
            ;;
        *)
            instructions+=("$1")
            ;;
    esac
    shift
done

if [[ -z "$mode" ]]; then
    usage
    exit 2
fi

if [[ "$preconfirmed" -eq 1 ]]; then
    if [[ "$mode" == ask ]]; then
        usage
        exit 2
    fi
    mode+="-yes"
fi

if [[ "$push" -eq 1 ]]; then
    mode+="-push"
fi

prompt="\$${commit_command} --$mode"
if ((${#instructions[@]})); then
    prompt+=" ${instructions[*]}"
fi

args=(--x-no-mcp -m "$model" -c "model_reasoning_effort=$effort")
args+=(--disable memories)
if [[ "$fast" -eq 1 ]]; then
    args+=(-c service_tier=fast)
fi
args+=("$prompt")
args+=("${codex_args[@]}")

exec "${CXCIA_CODEX_BIN:-codexd}" "${args[@]}"
